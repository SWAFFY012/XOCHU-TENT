# Скопируйте в .env.local (локально) или .env в каталоге приложения на сервере и заполните.
# Реальные ключи в репозиторий не коммитить.

# ── Сайт ──────────────────────────────────────────────────────
# Основной домен: canonical, sitemap, robots, OG. Можно кириллицей или punycode.
NEXT_PUBLIC_SITE_URL=https://хочу-тент.рф

# ── Telegram: заказы и заявки менеджеру ──────────────────────
# Токен бота: @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# ID чата или группы, куда приходят заказы.
# Узнать: добавьте бота в чат, напишите сообщение и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id
TELEGRAM_CHAT_ID=

# ── Заказы ────────────────────────────────────────────────────
# Файл с заказами (JSON). По умолчанию .data/orders.json в каталоге приложения.
ORDERS_FILE=
# Пароль для страницы /admin (смена статусов, трек-номера). Пусто — админка выключена.
ADMIN_PASSWORD=

# ── Битрикс24 ────────────────────────────────────────────────
# Входящий вебхук с правами CRM: заказы и заявки создают контакт и сделку в «Общей воронке».
# Вид: https://<портал>.bitrix24.ru/rest/<id>/<код>/ — это секрет, в репозиторий не коммитить.
BITRIX_WEBHOOK_URL=

# ── Оплата Ozon Pay ───────────────────────────────────────────
# true — «Оформить и оплатить» ведёт на платёжную форму. false — заказ создаётся, ссылку присылает менеджер.
# Включать после проверки оплаты тестовым токеном (OZONPAY_TEST_MODE).
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Кабинет эквайринга Ozon Банка → токен магазина. Документация: https://docs.ozon.ru/api/acquiring/
# В настройках токена включите «Отправлять POST-нотификации» на https://<домен>/api/payments/ozonpay/webhook
# ID токена, секретный ключ (подпись запросов) и секретный ключ для нотификаций
OZONPAY_ACCESS_KEY=
OZONPAY_SECRET_KEY=
OZONPAY_WEBHOOK_SECRET=
# Необязательно: адрес API, ставка НДС в чеке (ИП на упрощёнке — без НДС), приём тестовых оплат
# OZONPAY_API_URL=https://payapi.ozon.ru
# OZONPAY_VAT=VAT_NONE
# OZONPAY_TEST_MODE=true

# ── Письма покупателю (готовность заказа, трек-номер) ────────
# Например, Яндекс 360: smtp.yandex.ru, 465, пароль приложения
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Доставка ──────────────────────────────────────────────────
# Службы: СДЭК и Ozon. Без ключей служба остаётся в корзине с пометкой «рассчитает менеджер».

# Яндекс Карты для выбора пункта выдачи: developer.tech.yandex.ru -> «JavaScript API и HTTP Геокодер».
# Вшивается при сборке — задать переменной репозитория на GitHub. Без ключа карта тоже работает, но по правилам Яндекса ключ нужен.
NEXT_PUBLIC_YANDEX_MAPS_KEY=

# СДЭК: ключи API по договору приходят письмом: Account -> CDEK_CLIENT_ID, Secure password -> CDEK_CLIENT_SECRET
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Тестовая среда: https://api.edu.cdek.ru/v2 (по умолчанию боевая https://api.cdek.ru/v2)
CDEK_API_URL=
# Код пункта СДЭК, куда курьер сдаёт груз (для создания отправлений из /admin)
CDEK_SHIPMENT_POINT=
# Тип договора: 1 — интернет-магазин, 2 — доставка
CDEK_ORDER_TYPE=1

# Ozon Логистика через Seller API (пока не подключена): кабинет Ozon -> Настройки -> Seller API
OZON_SELLER_CLIENT_ID=
OZON_SELLER_API_KEY=
